PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_SECONDS=604800
# 10-15: bcrypt work factor. Higher = slower, stronger (default 12).
BCRYPT_SALT_ROUNDS=12

# Comma-separated origins for browser clients (e.g. http://localhost:5173). Omitted = any origin in dev; set in production.
# CORS_ORIGIN=http://localhost:5173

# postgres (default when DB_DIALECT is omitted or postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=monetro
TYPEORM_SYNC=false
TYPEORM_LOGGING=false