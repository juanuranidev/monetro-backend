PORT=3000
# Full origin + global HTTP prefix (`api` — see `main.ts`). Use this value as Postman environment `baseUrl` (or equivalent) when calling the MCP/collections.
API_BASE_URL=http://localhost:3000/api
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_SECONDS=604800
# 10-15: bcrypt work factor. Higher = slower, stronger (default 12).
BCRYPT_SALT_ROUNDS=12

# Comma-separated origins for browser clients (e.g. http://localhost:5173). Omitted = any origin in dev; set in production.
# CORS_ORIGIN=http://localhost:5173

# IANA timezone for parsing naive transaction dates (Luxon). Example: Buenos Aires, Argentina.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- PostgreSQL (production: Supabase) ---
# In Supabase: Project Settings → Database → copy host, password, DB name ("postgres").
# Use DB_SSL=true for hosted Postgres (recommended).
# Pooler (Supavisor): copy host, port, and user exactly from Dashboard → Connect.
# Session pooler → port 5432, DB_USER MUST be postgres.<project-ref> (not plain "postgres") or you get ENOIDENTIFIER.
# Transaction pooler → port 6543, same username rule on shared pooler; TypeORM may need prepared statements disabled.
#
# DB_SSL=true
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.<project-ref-from-db.xxx.supabase.co>
# DB_PASSWORD=<database-password-from-dashboard>
# DB_NAME=postgres

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=monetro
TYPEORM_SYNC=false
TYPEORM_LOGGING=false